{
  "name": "ozon-shopping-mcp",
  "version": "0.1.1",
  "description": "Unofficial Ozon MCP server for buyer-side product search, prices, product cards, and reviews.",
  "type": "module",
  "bin": {
    "ozon-shopping-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "dev": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "postbuild": "node scripts/ensure-bin-mode.mjs",
    "setup": "tsx src/cli.ts setup",
    "start": "node dist/cli.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ozon",
    "shopping",
    "product-search",
    "ecommerce",
    "marketplace",
    "buyer",
    "playwright"
  ],
  "author": "Maxim Zaytcev <neosheps@gmail.com> (https://github.com/neosheps)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neosheps/ozon-shopping-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/neosheps/ozon-shopping-mcp/issues"
  },
  "homepage": "https://github.com/neosheps/ozon-shopping-mcp#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "playwright": "1.62.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
